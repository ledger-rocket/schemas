{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledger-rocket.github.io/schemas/domain/v1.0.0/access-grant-alert.schema.json",
  "version": "1.0.0",
  "title": "AccessGrantAlert",
  "description": "One ledger-service access-grant alert on the alerts SNS topic: a grant-log row with an alert, after its row object is in the audit store, or the clear of an export stop. Plain JSON, integers as numbers. Delivery is at least once; consumers dedupe on kind, database_generation and chain_seq (or cleared_at_ms). The root $schema keyword names the JSON Schema dialect; the payload property $schema names this schema.",
  "type": "object",
  "required": ["$schema", "kind", "database_generation"],
  "properties": {
    "$schema": {
      "const": "https://ledger-rocket.github.io/schemas/domain/v1.0.0/access-grant-alert.schema.json",
      "description": "Published URL of the frozen schema version that describes this alert; the latest URL, which a later version replaces, is never named"
    },
    "kind": {"type": "string", "enum": ["grant-log-row", "export-stop-cleared"]},
    "database_generation": {"$ref": "#/$defs/uuid"}
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["chain_seq", "row_hash", "site_id", "change_type", "alert", "actor_issuer_id", "actor_subject", "created_at_ms", "object_key"],
      "properties": {
        "$schema": true,
        "database_generation": true,
        "kind": {"const": "grant-log-row"},
        "chain_seq": {"type": "integer", "minimum": 1},
        "row_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "site_id": {"type": ["integer", "null"], "minimum": 1},
        "change_type": {"type": "string", "minLength": 1, "maxLength": 50},
        "alert": {"type": "string", "minLength": 1},
        "actor_issuer_id": {"type": "integer", "minimum": 0},
        "actor_subject": {"type": "string", "minLength": 1, "maxLength": 255},
        "created_at_ms": {"type": "integer", "minimum": 0},
        "object_key": {"type": "string", "pattern": "^access-grant-log/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}/[0-9]{20}\\.json$"}
      }
    },
    {
      "additionalProperties": false,
      "required": ["stopped_reason", "stopped_at_ms", "cleared_reason", "cleared_by", "cleared_at_ms", "exported_chain_seq"],
      "properties": {
        "$schema": true,
        "database_generation": true,
        "kind": {"const": "export-stop-cleared"},
        "stopped_reason": {"type": "string", "minLength": 1, "maxLength": 4096, "description": "The stop reason, at most 4,096 characters; a longer reason is cut and ends with its full length"},
        "stopped_at_ms": {"type": ["integer", "null"], "minimum": 0},
        "cleared_reason": {"type": "string", "minLength": 1},
        "cleared_by": {"type": "string", "minLength": 1},
        "cleared_at_ms": {"type": "integer", "minimum": 0},
        "exported_chain_seq": {"type": "integer", "minimum": 0}
      }
    }
  ],
  "$defs": {
    "uuid": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"}
  }
}
