{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ledger-rocket.github.io/schemas/domain/v1.0.0/template.put.schema.json",
  "title": "Template PUT request",
  "description": "Body of PUT /api/v1/sites/{site_id}/templates/{template_id} on accounting-rule-engine: the domain template without site_id and template_id. The path names both, the service writes them into the stored template, and a body that carries either is refused. Each property reuses the domain template schema's definition.",
  "type": "object",
  "version": "1.0.0",
