    "$schema",
    "name",
    "description",
    "trigger",
    "accounting_treatments",
    "account_code_validations",
    "financial_statements_impact",
    "product",
    "event_type",
    "category",
    "variables",
    "validations",
    "legs",
    "metadata_schema"
  ],
  "properties": {
    "$schema": {
      "$ref": "template.schema.json#/properties/$schema",
      "description": "Canonical path to the JSON schema that describes this request body. accounting-rule-engine stores the template with the domain template schema URL in its place.",
      "examples": [
        "https://ledger-rocket.github.io/schemas/domain/v1.0.0/template.put.schema.json"
      ]
    },
