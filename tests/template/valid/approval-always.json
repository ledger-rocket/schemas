{
  "$schema": "https://ledger-rocket.github.io/schemas/domain/v1.1.0/template.schema.json",
  "template_id": 7010,
  "site_id": 1,
  "name": "Retail GBP/EUR Exchange",
  "product": "FX",
  "event_type": "CURRENCY_EXCHANGE",
  "category": "RETAIL_FX",
  "description": "Exchanges a customer's money between their own GBP and EUR accounts at Northstar UK at a quoted rate; Northstar FX takes the other side through its vostros. Standard and Plus plans pay a fair-usage fee above their monthly allowance, at a rate set by the size of the exchange. The fee is FX income in the sold currency, booked by channel: app or partner app.",
  "trigger": "Customer accepts a GBP/EUR exchange quote between two of their own accounts, in the Northstar app or in a partner app",
  "capabilities": [
    "allows_fx_transfers"
  ],
  "execution_class": "payments",
  "execution_approval": {
    "mode": "always",
    "proposal_ttl": "7d"
  },
  "account_code_validations": [
    {
      "purpose": "customer_source_liability",
      "mask": "21010",
      "description": "Customer's current account in the currency they sell"
    },
    {
      "purpose": "customer_target_liability",
      "mask": "21010",
      "description": "Customer's current account in the currency they buy"
    },
    {
      "purpose": "fx_hub_vostro_source",
      "mask": "22020",
      "description": "Northstar FX vostro at Northstar UK in the sold currency"
    },
    {
      "purpose": "fx_hub_vostro_target",
      "mask": "22020",
      "description": "Northstar FX vostro at Northstar UK in the bought currency"
    },
    {
      "purpose": "fx_fee_revenue_app_gbp",
      "mask": "40040",
      "description": "FX income of Northstar UK from in-app exchanges, GBP ledger"
    },
    {
      "purpose": "fx_fee_revenue_app_eur",
      "mask": "40040",
      "description": "FX income of Northstar UK from in-app exchanges, EUR ledger"
    },
    {
      "purpose": "fx_fee_revenue_partner_gbp",
      "mask": "40040",
      "description": "FX income of Northstar UK from partner-app exchanges, GBP ledger"
    },
    {
      "purpose": "fx_fee_revenue_partner_eur",
      "mask": "40040",
      "description": "FX income of Northstar UK from partner-app exchanges, EUR ledger"
    }
  ],
  "accounting_treatments": [
    {
      "type": "internal_transfer",
      "policy_refs": [
        {
          "id": "IAS21.21"
        }
      ],
      "description": "The customer's deposits are exchanged against Northstar FX's vostro balances at the quoted spot rate on the transaction date."
    },
    {
      "type": "fee_revenue",
      "policy_refs": [
        {
          "id": "IFRS15.38"
        },
        {
          "id": "IFRS15.114"
        }
      ],
      "description": "The fair-usage fee is revenue at the point in time the exchange is performed. It is booked by sales channel, app or partner app, so revenue can be disaggregated by channel."
    }
  ],
  "financial_statements_impact": [
    {
      "ledger_scope": "operational_source",
      "account_type": "LIABILITY",
      "impact": "decrease_or_no_impact",
      "description": "The customer's deposit falls by the amount sold plus any fee; Northstar FX's vostro rises by the amount sold."
    },
    {
      "ledger_scope": "operational_source",
      "account_type": "REVENUE",
      "impact": "increase_or_no_impact",
      "description": "FX income rises by the fair-usage fee when one is due."
    },
    {
      "ledger_scope": "operational_target",
      "account_type": "LIABILITY",
      "impact": "decrease_or_no_impact",
      "description": "Northstar FX's vostro falls and the customer's deposit rises by the same bought amount, so total liabilities on this ledger do not change."
    }
  ],
  "ledger_scope_descriptions": {
    "operational_source": "Northstar UK operational ledger in the currency the customer sells.",
    "operational_target": "Northstar UK operational ledger in the currency the customer buys."
  },
  "variables": [
    {
      "name": "sell_currency",
      "value": "accounts.customer_source_liability.ledger.currency_code",
      "description": "Currency the customer sells. The fee is booked on this currency's ledger."
    },
    {
      "name": "buy_amount",
      "value": "convert(amount, sell_currency, accounts.customer_target_liability.ledger.currency_code, event.extra_metadata.fx_rate)",
      "description": "Amount the customer receives, in minor units of the bought currency, at the quoted rate.",
      "type": "integer",
      "export": true
    },
    {
      "name": "chargeable_amount",
      "value": "event.extra_metadata.plan in ['STANDARD', 'PLUS'] ? max(0, amount - event.extra_metadata.fee_free_allowance_remaining) : 0",
      "description": "Part of the sold amount above the plan's remaining fee-free allowance; zero on plans without the fee."
    },
    {
      "name": "fee_rate_bps",
      "value": "amount >= 2500000 ? 25 : (amount >= 500000 ? 35 : 50)",
      "description": "Fee rate in basis points, by the size of the exchange: 0.5% below 5,000.00, 0.35% from 5,000.00, 0.25% from 25,000.00 of the sold currency."
    },
    {
      "name": "fx_fee",
      "value": "has(event.extra_metadata.fee_waiver_reason) ? 0 : divide_with_bankers_rounding(chargeable_amount * fee_rate_bps, 10000)",
      "description": "Fair-usage fee in minor units of the sold currency, rounded half to even; zero when the event carries a fee waiver.",
      "type": "integer",
      "export": true
    },
    {
      "name": "via_partner_app",
      "value": "event.extra_metadata.channel == 'PARTNER_API'",
      "description": "True when a partner app started the exchange through the Northstar API."
    },
    {
      "name": "apply_fee_app_gbp",
      "value": "fx_fee > 0 && !via_partner_app && sell_currency == 'GBP'",
      "description": "A GBP fee is due on an exchange made in the Northstar app."
    },
    {
      "name": "apply_fee_app_eur",
      "value": "fx_fee > 0 && !via_partner_app && sell_currency == 'EUR'",
      "description": "A EUR fee is due on an exchange made in the Northstar app."
    },
    {
      "name": "apply_fee_partner_gbp",
      "value": "fx_fee > 0 && via_partner_app && sell_currency == 'GBP'",
      "description": "A GBP fee is due on an exchange made in a partner app."
    },
    {
      "name": "apply_fee_partner_eur",
      "value": "fx_fee > 0 && via_partner_app && sell_currency == 'EUR'",
      "description": "A EUR fee is due on an exchange made in a partner app."
    },
    {
      "name": "fx_fee_revenue_app_gbp",
      "value": "\"299b5d48-95e9-50c1-aa0d-25cb811c4019\"",
      "description": "FX trading income - GBP, UK: fees on exchanges made in the Northstar app."
    },
    {
      "name": "fx_fee_revenue_app_eur",
      "value": "\"a35e0f15-f384-567c-89ba-90228102b57f\"",
      "description": "FX trading income - EUR, UK: fees on exchanges made in the Northstar app."
    },
    {
      "name": "fx_fee_revenue_partner_gbp",
      "value": "\"350dbc3d-cfad-5342-b262-69287247f9d4\"",
      "description": "FX trading income, partner apps - GBP, UK: fees on exchanges made in partner apps."
    },
    {
      "name": "fx_fee_revenue_partner_eur",
      "value": "\"84f2142b-9069-5a17-bda8-93eea7fae510\"",
      "description": "FX trading income, partner apps - EUR, UK: fees on exchanges made in partner apps."
    }
  ],
  "validations": [
    {
      "name": "currencies_differ",
      "expression": "sell_currency != accounts.customer_target_liability.ledger.currency_code",
      "description": "An exchange must sell one currency and buy another."
    },
    {
      "name": "customer_owns_both_accounts",
      "expression": "accounts.customer_source_liability.entity_id == accounts.customer_target_liability.entity_id",
      "description": "Customers exchange only between their own accounts."
    },
    {
      "name": "fx_hub_owns_both_vostros",
      "expression": "accounts.fx_hub_vostro_source.entity_id == accounts.fx_hub_vostro_target.entity_id",
      "description": "Both sides of the exchange sit with the same group entity."
    },
    {
      "name": "rate_quoted_for_this_pair",
      "expression": "split_nth(event.extra_metadata.rate_pair, '/', 0) == sell_currency && split_nth(event.extra_metadata.rate_pair, '/', 1) == accounts.customer_target_liability.ledger.currency_code",
      "description": "The quoted rate must be for the currencies being exchanged, sold then bought."
    },
    {
      "name": "quote_still_valid",
      "expression": "event.extra_metadata.quote_expires_at >= event.occurred_at",
      "description": "The exchange must happen before the customer's quote expires."
    }
  ],
  "legs": [
    {
      "leg_number": 1,
      "description": "Customer sells the currency to Northstar FX at the quoted rate.",
      "debit_account": "accounts.customer_source_liability.account_id",
      "debit_account_type": "LIABILITY",
      "credit_account": "accounts.fx_hub_vostro_source.account_id",
      "credit_account_type": "LIABILITY",
      "amount": "amount",
      "condition": "always_true",
      "ledger_scope": "operational_source",
      "treatment_type": "internal_transfer"
    },
    {
      "leg_number": 2,
      "description": "Northstar FX delivers the bought currency to the customer.",
      "debit_account": "accounts.fx_hub_vostro_target.account_id",
      "debit_account_type": "LIABILITY",
      "credit_account": "accounts.customer_target_liability.account_id",
      "credit_account_type": "LIABILITY",
      "amount": "buy_amount",
      "condition": "always_true",
      "ledger_scope": "operational_target",
      "treatment_type": "internal_transfer"
    },
    {
      "leg_number": 3,
      "description": "Charge the GBP fair-usage fee on an in-app exchange.",
      "debit_account": "accounts.customer_source_liability.account_id",
      "debit_account_type": "LIABILITY",
      "credit_account": "fx_fee_revenue_app_gbp",
      "credit_account_type": "REVENUE",
      "amount": "fx_fee",
      "condition": "apply_fee_app_gbp",
      "ledger_scope": "operational_source",
      "treatment_type": "fee_revenue"
    },
    {
      "leg_number": 4,
      "description": "Charge the EUR fair-usage fee on an in-app exchange.",
      "debit_account": "accounts.customer_source_liability.account_id",
      "debit_account_type": "LIABILITY",
      "credit_account": "fx_fee_revenue_app_eur",
      "credit_account_type": "REVENUE",
      "amount": "fx_fee",
      "condition": "apply_fee_app_eur",
      "ledger_scope": "operational_source",
      "treatment_type": "fee_revenue"
    },
    {
      "leg_number": 5,
      "description": "Charge the GBP fair-usage fee on a partner-app exchange.",
      "debit_account": "accounts.customer_source_liability.account_id",
      "debit_account_type": "LIABILITY",
      "credit_account": "fx_fee_revenue_partner_gbp",
      "credit_account_type": "REVENUE",
      "amount": "fx_fee",
      "condition": "apply_fee_partner_gbp",
      "ledger_scope": "operational_source",
      "treatment_type": "fee_revenue"
    },
    {
      "leg_number": 6,
      "description": "Charge the EUR fair-usage fee on a partner-app exchange.",
      "debit_account": "accounts.customer_source_liability.account_id",
      "debit_account_type": "LIABILITY",
      "credit_account": "fx_fee_revenue_partner_eur",
      "credit_account_type": "REVENUE",
      "amount": "fx_fee",
      "condition": "apply_fee_partner_eur",
      "ledger_scope": "operational_source",
      "treatment_type": "fee_revenue"
    }
  ],
  "metadata_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "fx_rate": {
        "type": "string",
        "pattern": "^[0-9]+(\\.[0-9]+)?$",
        "description": "Quoted customer rate as a decimal string: units of the bought currency for one unit of the sold currency."
      },
      "rate_pair": {
        "type": "string",
        "enum": [
          "GBP/EUR",
          "EUR/GBP"
        ],
        "description": "Currency pair of the quote as ISO 4217 codes, sold then bought. This template books fees on the GBP and EUR ledgers only."
      },
      "quote_expires_at": {
        "type": "integer",
        "minimum": 0,
        "description": "Quote expiry in Unix milliseconds; the exchange must occur at or before it."
      },
      "plan": {
        "type": "string",
        "enum": [
          "STANDARD",
          "PLUS",
          "PREMIUM",
          "METAL",
          "ULTRA"
        ],
        "description": "Customer's account plan. Standard and Plus pay the fair-usage fee above their monthly allowance."
      },
      "fee_free_allowance_remaining": {
        "type": "integer",
        "minimum": 0,
        "description": "Fee-free exchange allowance left this month, in minor units of the sold currency. Applies to Standard and Plus plans."
      },
      "channel": {
        "type": "string",
        "enum": [
          "APP",
          "PARTNER_API"
        ],
        "description": "Where the customer made the exchange: APP is the Northstar app; PARTNER_API is a partner app through the Northstar API. Sets the income account for the fee."
      },
      "fee_waiver_reason": {
        "type": "string",
        "enum": [
          "PROMOTION",
          "SERVICE_RECOVERY"
        ],
        "description": "Why the fee is waived. Present only on a waived exchange, which books no fee."
      },
      "quote_id": {
        "type": "string",
        "minLength": 1,
        "description": "Identifier of the exchange quote the customer accepted."
      }
    },
    "required": [
      "fx_rate",
      "rate_pair",
      "quote_expires_at",
      "plan",
      "fee_free_allowance_remaining",
      "channel"
    ]
  },
